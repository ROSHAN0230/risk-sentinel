# Risk Sentinel — Environment Configuration
# Copy this file to .env to configure credentials (optional for running demo)

# Razorpay Test Mode Credentials (Optional: simulated mode active if omitted)
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourSecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Application Host & Port
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
